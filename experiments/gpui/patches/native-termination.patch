+// NSApplicationTerminateReply uses NSUInteger, not BOOL. SDK values:
+// NSTerminateCancel = 0, NSTerminateNow = 1 (NSTerminateLater = 2 is unused).
+fn should_cancel_native_quit(registered: bool, explicit: &mut bool) -> bool {
+    let approved = std::mem::take(explicit);
+    registered && !approved
+}
+
+extern "C" fn should_terminate(this: &mut Object, _: Sel, _: id) -> NSUInteger {
+    let platform = unsafe { get_mac_platform(this) };
+    let mut state = platform.0.lock();
+    let registered = state.native_quit_gate_enabled;
+    if !should_cancel_native_quit(registered, &mut state.explicit_quit) {
+        return 1;
+    }
+    let Some(mut callback) = state.native_quit_requested.take() else {
+        // Keep the gate closed even during a reentrant request while scheduling.
+        return 0;
+    };
+    drop(state);
+    // App's callback only enqueues work, so no AppCell borrow, dialog, or nested
+    // event loop occurs while AppKit is asking whether to terminate.
+    callback();
+    platform
+        .0
+        .lock()
+        .native_quit_requested
+        .get_or_insert(callback);
+    0
+}
