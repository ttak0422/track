+#[cfg(test)]
+mod termination_gate_tests {
+    use super::should_cancel_native_quit;
+    #[test]
+    fn opt_in_and_one_shot_approval() {
+        let mut approval = false;
+        assert!(!should_cancel_native_quit(false, &mut approval));
+        assert!(should_cancel_native_quit(true, &mut approval));
+        assert!(should_cancel_native_quit(true, &mut approval));
+        approval = true;
+        assert!(!should_cancel_native_quit(true, &mut approval));
+        assert!(!approval);
+        assert!(should_cancel_native_quit(true, &mut approval));
+    }
+
+    #[test]
+    fn approval_cannot_survive_an_unguarded_termination_attempt() {
+        let mut approval = true;
+        assert!(!should_cancel_native_quit(false, &mut approval));
+        assert!(!approval);
+        assert!(should_cancel_native_quit(true, &mut approval));
+    }
+
+    #[test]
+    fn temporarily_missing_callback_does_not_disable_registered_gate() {
+        // The native handler stores gate registration separately from the callback
+        // Option, which is temporarily taken while scheduling foreground work.
+        let mut approval = false;
+        assert!(should_cancel_native_quit(true, &mut approval));
+    }
+}
