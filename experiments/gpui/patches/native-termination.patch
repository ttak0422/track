+    /// Intercept native application quit requests (currently macOS only).
+    ///
+    /// Native termination is canceled before this callback is scheduled on the normal
+    /// foreground executor. Review all dirty documents, then call `App::quit()` only
+    /// after successful saving or explicit discard. `App::quit()` bypasses this gate.
+    /// Repeated requests may invoke the callback repeatedly; the controller must dedupe.
+    /// The handler lasts for the app lifetime and a new registration replaces it.
+    /// Returns false if the platform does not implement this gate.
+    pub fn on_native_quit_requested(&self, callback: impl FnMut(&mut App) + 'static) -> bool {
+        let callback = Rc::new(RefCell::new(callback));
+        let app = self.this.clone();
+        let executor = self.foreground_executor.clone();
+        self.platform.on_native_quit_requested(Box::new(move || {
+            let app = app.clone();
+            let callback = callback.clone();
+            executor
+                .spawn(async move {
+                    if let Some(app) = app.upgrade() {
+                        app.borrow_mut().update(|cx| (callback.borrow_mut())(cx));
+                    }
+                })
+                .detach();
+        }))
+    }
