{
  "title": "Cache observations \u00b7 synthetic",
  "panels": [
    {
      "type": "timeseries",
      "title": "Cache hit rate (%)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24
      },
      "datasource": {
        "type": "track",
        "uid": "observations.jsonl"
      },
      "targets": [
        {
          "expr": "demo_level",
          "legendFormat": "{{entity}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pct"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Daily change (pp)",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12
      },
      "datasource": {
        "type": "track",
        "uid": "observations.jsonl"
      },
      "targets": [
        {
          "expr": "demo_change_pp",
          "legendFormat": "{{entity}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentage_point"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Relative change (%)",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12
      },
      "datasource": {
        "type": "track",
        "uid": "observations.jsonl"
      },
      "targets": [
        {
          "expr": "demo_change_pct",
          "legendFormat": "{{entity}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pct"
        }
      }
    }
  ]
}
